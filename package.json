{
  "name": "mygame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "zip:itch": "cd dist && rm -f sairei-itch.zip ../sairei-itch.zip && zip -qr ../sairei-itch.zip . && mv ../sairei-itch.zip .",
    "preview": "vite preview --host",
    "sim": "tsx scripts/simulate.ts",
    "fonts": "tsx scripts/subset-fonts.ts",
    "ui-art": "tsx scripts/make-ui-art.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "happy-dom": "^20.14.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
